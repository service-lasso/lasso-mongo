{
  "id": "mongo",
  "name": "MongoDB",
  "description": "Release-backed MongoDB Community Server service for local Service Lasso data dependencies.",
  "version": "8.0.17",
  "enabled": true,
  "endpoints": [
    {
      "id": "mongo",
      "kind": "network",
      "label": "MongoDB TCP",
      "direction": "inbound",
      "transport": "tcp",
      "protocol": "tcp",
      "bind": "127.0.0.1",
      "port": {
        "default": 8180,
        "strategy": "preferred"
      },
      "exposure": "local",
      "required": true,
      "primary": true
    },
    {
      "id": "mongodb",
      "kind": "url",
      "label": "mongodb",
      "target": "mongo",
      "url": "mongodb://${MONGO_USERNAME}:***@${endpoint.mongo.bind}:${endpoint.mongo.port}/admin",
      "exposure": "local",
      "required": true,
      "primary": true
    }
  ],
  "env": {
    "MONGO_HOST": "${endpoint.mongo.bind}",
    "MONGO_PORT": "${endpoint.mongo.port}",
    "MONGO_USERNAME": "mongoadmin",
    "MONGO_PASSWORD": "mongoadmin",
    "MONGO_DATA_DIR": "${SERVICE_ROOT}/runtime/data",
    "MONGO_BIND_IP": "127.0.0.1",
    "MONGOSH_DISABLE_TELEMETRY": "1"
  },
  "globalenv": {
    "MONGO_HOST": "${MONGO_HOST}",
    "MONGO_PORT": "${MONGO_PORT}",
    "MONGO_USERNAME": "${MONGO_USERNAME}",
    "MONGO_PASSWORD": "${MONGO_PASSWORD}",
    "MONGO_HOME": "${SERVICE_ARTIFACT_ROOT}"
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-mongo",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-mongo-8.0.17-mongosh-2.8.2-win32.zip",
        "archiveType": "zip",
        "command": "node",
        "args": ["./lasso-mongo.mjs"]
      },
      "linux": {
        "assetName": "lasso-mongo-8.0.17-mongosh-2.8.2-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "node",
        "args": ["./lasso-mongo.mjs"]
      },
      "darwin": {
        "assetName": "lasso-mongo-8.0.17-mongosh-2.8.2-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "node",
        "args": ["./lasso-mongo.mjs"]
      }
    }
  },
  "install": {
    "files": [
      {
        "path": "./runtime/.keep",
        "content": ""
      }
    ]
  },
  "healthchecks": [
    {
      "id": "mongo-tcp-ready",
      "type": "tcp",
      "address": "${endpoint.mongo.bind}:${endpoint.mongo.port}",
      "retries": 80,
      "interval": 250
    }
  ],
  "updates": {
    "enabled": true,
    "mode": "notify",
    "track": "latest",
    "checkIntervalSeconds": 86400
  }
}
